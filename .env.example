# Copy this file to .env and adjust values as needed
# Frontend API configuration

# LOCAL DEV: Do NOT set this — the Vite proxy maps /api/* → localhost:8000 automatically.
# PRODUCTION (Vercel): Set this in Vercel's Environment Variables dashboard (not in this file).
# VITE_API_BASE_URL=https://your-app-name.onrender.com

VITE_API_TIMEOUT=10000
